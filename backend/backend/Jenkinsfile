pipeline {
    agent any
    tools
    {
        maven "M2_HOME"
        jdk "JAVA_HOME"
    }
    stages {
        stage('Git Checkout') 
        {
            steps {
               git branch: 'main',
               url:'https://github.com/PYROXA1/DevOps-AppGestionDesProjets.git'
          //     url:'https://github.com/PYROXA1/DevOps-AppGestionDesProjets/tree/main/backend'
            }
                
        }
        stage('Build') 
        {
            steps 
            {
                sh "mvn clean compile"
              
            }
                
        }
        
    }
}
